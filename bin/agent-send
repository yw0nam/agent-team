#!/usr/bin/env bash
# agent-send — session-persistent messaging to coding-agent CLIs.
# Role-based: `agent-send <role> <session-name> <msg...>` resolves backend/model/write
# from the config. Low-level: `agent-send [-w] [-m MODEL] <backend> <session-name> <msg...>`.
# Sessions are keyed by (cwd, backend, name); state is one file holding the session id.
set -uo pipefail

CONFIG="${AGENT_TEAM_CONFIG:-$HOME/.config/agent-team/config.json}"
BACKENDS="codex opencode claude pi"

usage() {
  cat >&2 <<EOF
usage: agent-send [-w] [-m MODEL] <role|backend> <session-name> <message...>
       agent-send --list
       agent-send --roles
       agent-send --models [backend]
       agent-send --log <session-name>
backends: $BACKENDS   roles: defined in $CONFIG
  -w        allow writes (codex sandbox write, opencode --auto, claude acceptEdits, pi edit+write tools)
  -m        model override (passed to the backend's model flag)
  --list    list sessions for the current directory
  --roles   show configured roles
  --models  list models currently available per backend (default: all installed)
  --log     print a session's work log (write roles journal there; the reply
            you get back is only the summary)
EOF
  exit 2
}

state_dir="/tmp/agent-team/$(pwd -P | sha1sum | cut -c1-12)"
# Work logs live in the tree the agent works on (worktrees isolate themselves),
# not in state_dir: the point is that they are readable next to the diff.
log_dir="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)/.agent-team"

case "${1:-}" in
--log)
  f="$log_dir/${2:?--log needs a session name}.md"
  [[ -f $f ]] || {
    echo "agent-send: no work log at $f" >&2
    exit 1
  }
  cat "$f"
  exit 0
  ;;
--list)
  ls -1 "$state_dir" 2>/dev/null
  exit 0
  ;;
--roles)
  jq -r '.roles | to_entries[] | "\(.key): \(.value.backend)\(if .value.model then " · " + .value.model else "" end)\(if .value.write then " · write" else " · read-only" end)"' "$CONFIG" 2>/dev/null ||
    echo "agent-send: no roles configured at $CONFIG" >&2
  exit 0
  ;;
--models)
  for b in ${2:-$BACKENDS}; do
    command -v "$b" >/dev/null || continue
    echo "## $b"
    case "$b" in
    codex) codex debug models 2>/dev/null | jq -r '.models[] | select(.slug) | "\(.slug)\t\(.description // "")"' ;;
    opencode) opencode models 2>/dev/null ;;
    claude) echo "no list command; aliases always resolve to the latest model: opus, sonnet, haiku (full ids like claude-opus-4-8 also accepted)" ;;
    pi) pi --list-models 2>/dev/null ;;
    esac
    echo
  done
  exit 0
  ;;
esac

write=0 model=""
while [[ "${1:-}" == -* ]]; do
  case "$1" in
  -w) write=1; shift ;;
  -m) model="${2:?-m needs a value}"; shift 2 ;;
  *) usage ;;
  esac
done
[[ $# -ge 3 ]] || usage
target=$1 name=$2
shift 2
msg="$*"

if [[ " $BACKENDS " == *" $target "* ]]; then
  backend=$target
else
  [[ -f $CONFIG ]] || {
    echo "agent-send: '$target' is not a backend ($BACKENDS) and no config exists at $CONFIG." >&2
    echo "agent-send: define roles there (see the agent-team skill) or use a backend name." >&2
    exit 1
  }
  backend=$(jq -r --arg r "$target" '.roles[$r].backend // empty' "$CONFIG")
  [[ -n $backend ]] || {
    echo "agent-send: unknown role '$target'. Configured roles: $(jq -r '.roles | keys | join(", ")' "$CONFIG")" >&2
    exit 1
  }
  [[ " $BACKENDS " == *" $backend "* ]] || {
    echo "agent-send: role '$target' maps to unsupported backend '$backend' ($BACKENDS)" >&2
    exit 1
  }
  ((write)) || [[ $(jq -r --arg r "$target" '.roles[$r].write // false' "$CONFIG") != true ]] || write=1
  [[ -n $model ]] || model=$(jq -r --arg r "$target" '.roles[$r].model // empty' "$CONFIG")
fi

command -v "$backend" >/dev/null || {
  echo "agent-send: '$backend' is not installed" >&2
  exit 127
}

mkdir -p "$state_dir"
sf="$state_dir/$backend-$name"

die_stale() {
  echo "agent-send: resume failed for session '$name' (id: $(cat "$sf"))." >&2
  echo "agent-send: if the session is gone, delete $sf and retry to start fresh." >&2
  exit 1
}

# One file per session: the spec, the agent's notes, its own summary. The
# agent writes all of it — the wrapper only guarantees the directory exists.
logfile="$log_dir/$name.md"

if ((write)); then
  mkdir -p "$log_dir"
  # the directory ignores itself: work logs are scratch next to the diff, not
  # repo content the user has to notice and clean out of `git status`
  [[ -f $log_dir/.gitignore ]] || printf '*\n' >"$log_dir/.gitignore"
  # Delegated agents keep the long story in the worktree and hand back only the
  # summary — otherwise every delegation dumps a transcript into the
  # orchestrator's context, and the reasoning is lost the moment it scrolls.
  msg="$msg

--- reporting protocol ---
Append to $logfile — append only, never rewrite earlier entries:
'## <ISO timestamp> — <one-line task>', then '### spec' holding the task above
copied verbatim, then '### notes': what you did and why, decisions and the
alternatives you rejected, commands you ran, anything you could not finish.
Then reply with the report only — the reasoning stays in the log — using
exactly these sections, each kept tight:

## Summary
2-4 sentences: what works now that did not before.
## Changes
one line per file: <absolute path> — what changed and why.
## Verification
the commands you ran and their results, or why you could not run them.
## Notes
assumptions, rejected alternatives worth knowing, follow-ups, blockers, or
'none'.
## Log
$logfile"
fi

case "$backend" in
codex)
  # --json: the human-readable banner ("session id: ...") is not a stable
  # contract — a CLI update can add a warning line, recolor, or reword it
  # and silently break extraction after a successful, billable run. The
  # JSONL event stream's thread_id field is the documented, structured id.
  flags=(--skip-git-repo-check --json)
  # -c, not -s: the same flags array feeds both `codex exec` and `codex exec
  # resume`, and resume rejects -s/--sandbox ("unexpected argument '-s'").
  # The config override is accepted by both. (--full-auto is deprecated.)
  # network_access: without it the sandbox blocks socket(), so asyncio can't
  # build its self-pipe and starlette's TestClient hangs forever — pytest
  # suites stall instead of failing. Scoped to delegated write sessions; the
  # user's own codex keeps its default posture.
  ((write)) && {
    flags+=(-c sandbox_mode="workspace-write" -c sandbox_workspace_write.network_access=true)
    # The sandbox root is cwd, but in a linked worktree (or any subdirectory of
    # a repo) the real git dir lives outside it, so every git write dies with
    # "Read-only file system". codex then asks to escalate, and `exec` has
    # nobody to answer — the agent reports it simply cannot use git.
    gd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    [[ -n $gd && $gd != "$(pwd -P)"/* ]] &&
      flags+=(-c "sandbox_workspace_write.writable_roots=[\"$gd\"]")
  }
  [[ -n $model ]] && flags+=(-m "$model")
  # </dev/null: codex exec waits for stdin EOF; a backgrounded caller's open
  # stdin pipe never sends one, hanging codex before its first turn.
  if [[ -f $sf ]]; then
    out=$(codex exec resume "$(cat "$sf")" "${flags[@]}" "$msg" </dev/null 2>&1) || {
      printf '%s\n' "$out"
      die_stale
    }
  else
    # Run in the background and poll for the thread_id as soon as it
    # appears instead of waiting for the whole command to finish, so a
    # long task killed by an external timeout (e.g. the harness's default
    # 2min Bash timeout when not backgrounded) stays resumable instead of
    # being silently orphaned (see the same fix applied to opencode above).
    tmp_out=$(mktemp)
    codex exec "${flags[@]}" "$msg" </dev/null >"$tmp_out" 2>&1 &
    pid=$!
    id=""
    while kill -0 "$pid" 2>/dev/null; do
      id=$(sed -n 's/.*"thread_id":"\([^"]*\)".*/\1/p' "$tmp_out" | head -1)
      [[ -n $id ]] && break
      sleep 0.3
    done
    [[ -n $id ]] && printf '%s\n' "$id" >"$sf"
    wait "$pid"
    rc=$?
    out=$(<"$tmp_out")
    rm -f "$tmp_out"
    [[ $rc -eq 0 ]] || {
      printf '%s\n' "$out"
      exit "$rc"
    }
    [[ -n $id ]] || id=$(sed -n 's/.*"thread_id":"\([^"]*\)".*/\1/p' <<<"$out" | head -1)
    [[ -n $id ]] || {
      printf '%s\n' "$out"
      echo "agent-send: could not extract codex session id" >&2
      exit 1
    }
    printf '%s\n' "$id" >"$sf"
  fi
  # keep only the final assistant message from the JSONL event stream;
  # grep isolates real event lines first since codex prepends plain-text
  # notices (e.g. "Reading additional input from stdin...") that aren't JSON
  grep '^{' <<<"$out" |
    jq -rj 'select(.type == "item.completed" and .item.type == "agent_message") | .item.text + "\n"' 2>/dev/null ||
    printf '%s\n' "$out"
  ;;
opencode)
  flags=(--format json)
  ((write)) && flags+=(--auto)
  [[ -n $model ]] && flags+=(-m "$model")
  if [[ -f $sf ]]; then
    out=$(opencode run "${flags[@]}" --session "$(cat "$sf")" "$msg" 2>&1) || {
      printf '%s\n' "$out"
      die_stale
    }
  else
    # Run in the background and poll for the sessionID as soon as it appears
    # (it's in the first JSON event, within ~1s) instead of waiting for the
    # whole command to finish. A long task killed by an external timeout
    # (e.g. the harness's default 2min Bash timeout when not backgrounded)
    # would otherwise leave the session fully untracked: opencode keeps
    # running/burns tokens, but agent-send never learns its id and the next
    # call starts a brand-new session instead of resuming.
    tmp_out=$(mktemp)
    opencode run "${flags[@]}" "$msg" >"$tmp_out" 2>&1 &
    pid=$!
    id=""
    while kill -0 "$pid" 2>/dev/null; do
      id=$(sed -n 's/.*"sessionID":"\([^"]*\)".*/\1/p' "$tmp_out" | head -1)
      [[ -n $id ]] && break
      sleep 0.3
    done
    [[ -n $id ]] && printf '%s\n' "$id" >"$sf"
    wait "$pid"
    rc=$?
    out=$(<"$tmp_out")
    rm -f "$tmp_out"
    [[ $rc -eq 0 ]] || {
      printf '%s\n' "$out"
      exit "$rc"
    }
    [[ -n $id ]] || id=$(sed -n 's/.*"sessionID":"\([^"]*\)".*/\1/p' <<<"$out" | head -1)
    [[ -n $id ]] || {
      printf '%s\n' "$out"
      echo "agent-send: could not extract opencode session id" >&2
      exit 1
    }
    printf '%s\n' "$id" >"$sf"
  fi
  # keep only assistant text from the JSON event stream
  jq -rj 'select(.type == "text") | .part.text + "\n"' <<<"$out" 2>/dev/null ||
    printf '%s\n' "$out"
  ;;
claude)
  flags=(-p --output-format json)
  ((write)) && flags+=(--permission-mode acceptEdits)
  [[ -n $model ]] && flags+=(--model "$model")
  if [[ -f $sf ]]; then
    out=$(claude "${flags[@]}" --resume "$(cat "$sf")" "$msg" 2>&1) || {
      printf '%s\n' "$out"
      die_stale
    }
  else
    out=$(claude "${flags[@]}" "$msg" 2>&1)
    rc=$?
    [[ $rc -eq 0 ]] || {
      printf '%s\n' "$out"
      exit "$rc"
    }
  fi
  id=$(jq -r '.session_id // empty' <<<"$out" 2>/dev/null)
  if [[ -n $id ]]; then
    printf '%s\n' "$id" >"$sf" # claude may rotate ids on resume; always store the latest
  elif [[ ! -f $sf ]]; then
    printf '%s\n' "$out"
    echo "agent-send: could not extract claude session id" >&2
    exit 1
  fi
  jq -r '.result' <<<"$out" 2>/dev/null || printf '%s\n' "$out"
  ;;
pi)
  # pi names its own sessions: --session-id creates the id if it does not exist
  # and resumes it if it does, so there is no id to scrape and a run killed by
  # a timeout can never be orphaned. Session storage is per-project (cwd), which
  # already matches agent-send's (cwd, backend, name) key; the state file is
  # written only so --list shows the session.
  id="agent-team-$name"
  flags=(-p --mode json --session-id "$id")
  # ponytail: pi has no sandbox, so read-only == drop the mutating tools.
  # bash stays (a reviewer needs grep/ls) — this is a tool filter, not a jail.
  ((write)) || flags+=(-xt edit,write)
  [[ -n $model ]] && flags+=(--model "$model")
  out=$(pi "${flags[@]}" "$msg" </dev/null 2>&1)
  rc=$?
  [[ $rc -eq 0 ]] || {
    printf '%s\n' "$out"
    exit "$rc"
  }
  printf '%s\n' "$id" >"$sf"
  # keep the assistant text of every turn; grep isolates the JSONL events from
  # pi's plain-text notices (e.g. the "creating a new session" warning)
  events=$(grep '^{' <<<"$out")
  text=$(jq -rj 'select(.type == "turn_end") | (.message.content[]? | select(.type == "text") | .text + "\n")' <<<"$events" 2>/dev/null)
  if [[ -n $text ]]; then
    printf '%s\n' "$text"
  else
    # pi exits 0 even when the turn failed (unknown model, provider 400, auth):
    # the reason lives in the event stream as stopReason "error", so without
    # this the caller gets an empty success and no idea anything went wrong.
    printf '%s\n' "$out" >&2
    err=$(jq -r 'select(.type == "turn_end") | .message.errorMessage // empty' <<<"$events" 2>/dev/null | head -1)
    echo "agent-send: pi returned no assistant text${err:+ — $err}" >&2
    exit 1
  fi
  ;;
esac
